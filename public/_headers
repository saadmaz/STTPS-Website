# Response headers for the static export, read by Cloudflare from the root of
# the assets directory (see wrangler.jsonc). Replaces the security headers
# that used to live in public/.htaccess (Apache/cPanel) and, before that, in
# next.config.ts's headers() — that API only runs against Next's own server
# and is a build error under `output: "export"`, so this file is where they
# belong.
#
# Keep the CSP in sync with any script/style changes in the app:
# 'unsafe-inline' covers Motion's inline styles, and there is no nonce so
# every page can stay statically generated.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# _next/static filenames are content-hashed by Next, so they can be cached
# forever. HTML is deliberately left alone so a deploy shows up immediately
# rather than being pinned in a cache.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
